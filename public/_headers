# Security headers for the SPA document and static assets.
#
# The worker only runs for /api/* and /agents/* (assets.run_worker_first), so the
# securityHeaders middleware never touches the HTML document — these headers do.
# Natively supported by Workers static assets: this file is copied into
# dist/client by Vite and parsed by Cloudflare (not served as an asset).
# The client PDFs need three things here: 'wasm-unsafe-eval' (WebAssembly only,
# not eval) and connect-src data: for react-pdf's inlined yoga wasm, and
# worker-src blob: for the compression worker fflate spawns. font-src data:
# is FullCalendar's inlined icon font (fcicons).
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' data: https://tracking.gritoweb.com.br wss://tracking.gritoweb.com.br; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'

# Everything under /assets/ is content-hashed by Vite, so it can be cached
# forever — without this, Workers Assets serves max-age=0, must-revalidate and
# every repeat visit pays a conditional request per chunk/font. index.html keeps
# the platform default short cache so deploys still propagate immediately.
/assets/*
  Cache-Control: public, max-age=31536000, immutable


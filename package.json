		}
	},
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"build": "tsc -b && vite build",
		"build:ext": "cd extension && vite build && (cp -r icons ../dist/extension/ 2>/dev/null || true)",
		"build:ext:dev": "cd extension && vite build --mode development && (cp -r icons ../dist/extension/ 2>/dev/null || true)",
		"zip:ext": "pnpm build:ext && cd dist/extension && zip -qr -X ../timetracker-extension.zip . -x '.*' && echo 'Wrote dist/timetracker-extension.zip (upload this to the Chrome Web Store)'",
		"ext:id": "openssl rsa -in extension/.keys/extension.pem -pubout -outform DER 2>/dev/null | openssl dgst -sha256 -binary | xxd -p -c 32 | head -c 32 | tr '0-9a-f' 'a-p'; echo",
		"generate-icons": "node scripts/generate-icons.mjs",
		"cf-typegen": "wrangler types",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"deploy": "pnpm build && wrangler deploy",
		"versions:upload": "pnpm build && wrangler versions upload",
		"dev": "vite",
		"email:dev": "email dev --dir src/worker/emails --port 3333",
		"lint": "eslint . --max-warnings 0",
		"preview": "KEEP_DEV_VARS=1 pnpm run build && vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"seed:demo": "node scripts/seed-feature-demo.mjs"
	},
	"type": "module"
}

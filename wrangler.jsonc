{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracking",
  "main": "./src/worker/index.ts",
  // Pinned to the installed workerd's date (1.20260708.1), not "today": a
  // compat date ahead of the local runtime makes `wrangler dev` and the e2e
  // suite run on different semantics than the config claims, and warns on every
  // invocation. Bump this together with the workerd/wrangler dependency.
  //
  // Crossing 2026-04-07 turns on `web_socket_auto_reply_to_close`. Measured
  // against production, that did NOT actually reciprocate Close frames — the
  // wire showed 1006 once the manual handshake was removed — so TimerRoom still
  // closes by hand. Read its webSocketClose comment before touching that again.
  "compatibility_date": "2026-07-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  // Explicitly off (wrangler infers false once routes exist, but a config edit
  // could silently re-enable them). A second live origin on *.workers.dev would
  // sit outside trustedOrigins/CORS and split the passkey rpID.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_URL": "https://tracking.gritoweb.com.br",
    "ENABLE_PASSWORD_AUTH": "true",
    // Sender for every outgoing email (lib/mailer.ts); must be on a domain verified in Resend.
    "EMAIL_FROM": "noreply@gritoweb.com.br"
  },
  // Auto-track: sweep finished Google Calendar events into time entries every 5 min.
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // Top-level navigations (Sec-Fetch-Mode: navigate) to non-asset paths get the
    // SPA index.html unless the path is routed to the worker here. The Google OAuth
    // callback is a navigation, so without this it never reaches Better Auth.
    "run_worker_first": ["/api/*", "/agents/*", "/mcp", "/mcp/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "time-tracker",
      "database_id": "ce30b90c-f188-44f6-bffb-c4e8102a6f84"
    }
  ],
  // Task attachments (D7); real bucket only gets created on deploy day, like the D1 migrations above.
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "tracking-attachments"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        // Binding name is unchanged (`env.TIMER_ROOM`), only the class behind
        // it — see the v3 migration for why the class had to be renamed.
        "name": "TIMER_ROOM",
        "class_name": "TimerRoom"
      },
      // Assistant chat: one AIChatAgent instance per workspace. Persists conversation
      // history + resumable streams in its own SQLite (hence new_sqlite_classes).
      {
        "name": "CHAT_AGENT",
        "class_name": "ChatAgent"
      },
      // One instance per user — delivers their own notifications, separate from the
      // per-workspace TimerRoom (which stays about timers/entries/tasks only).
      {
        "name": "NOTIFICATION_ROOM",
        "class_name": "NotificationRoom"
      },
      // One room per task description for live co-editing (Yjs). Dormant until COLLAB_DESCRIPTIONS is "true".
      {
        "name": "DESCRIPTION_ROOM",
        "class_name": "DescriptionRoom"
      }
    ]
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  // Shared request limits, one counter per Cloudflare location instead of one per isolate. Permissive and
  // eventually consistent by design, so they slow brute force and abuse rather than count exactly. The
  // namespace_id must be unique in the whole account (not just this project), hence the unusual numbers.
  "ratelimits": [
    { "name": "AUTH_LIMITER", "namespace_id": "540101", "simple": { "limit": 10, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "540102", "simple": { "limit": 20, "period": 60 } },
    { "name": "MCP_LIMITER", "namespace_id": "540103", "simple": { "limit": 600, "period": 60 } }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_classes": ["TimerRoomDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ChatAgent"]
    },
    // v3 — move the timer room off the legacy key-value storage backend.
    //
    // There is no in-place KV→SQLite migration: "You cannot enable a SQLite
    // storage backend on an existing, deployed Durable Object class." The only
    // route today is to delete the namespace and create a new one, and since a
    // class name can't be both deleted and live in the same config, the class
    // had to be renamed (TimerRoomDO → TimerRoom).
    //
    // Safe to delete precisely because this DO has never persisted anything:
    // no ctx.storage access anywhere, D1 is the source of truth, and
    // per-connection state lives in the socket attachment. What it costs is one
    // reconnect — every live socket drops on deploy and the client's 1s→30s
    // backoff picks them back up.
    //
    // Done now rather than later because the window is only free while the DO
    // stays stateless. Do NOT write to ctx.storage in TimerRoom without
    // revisiting this: from that point the same move loses real data.
    //
    // Create and delete are SEPARATE tags applied by SEPARATE deploys, and the
    // old class stays exported across the first one. That is not stylistic —
    // two API checks pin this move and cannot both be satisfied at once:
    //
    //   10061 — "Cannot apply --delete-class migration to class 'TimerRoomDO'
    //            without also removing the binding that references it."
    //            Validated against the *currently deployed* script, so the
    //            binding must already point elsewhere in a live deploy.
    //
    //   10064 — "New version of script does not export class 'TimerRoomDO'
    //            which is depended on by existing Durable Objects."
    //            A script cannot stop exporting a class whose namespace lives.
    //
    // The binding must move away BEFORE the delete; the class must stay
    // exported UNTIL the delete. So: v3 creates TimerRoom and repoints the
    // binding while a stub keeps TimerRoomDO exported
    // (durable-objects/TimerRoomDO.legacy.ts), and v4 deletes the namespace and
    // the stub together.
    {
      "tag": "v3",
      "new_sqlite_classes": ["TimerRoom"]
    },
    // v4 — drop the now-orphaned legacy namespace and its tombstone export.
    // Legal only because v3 already shipped: the live binding points at
    // TimerRoom (clears 10061) and this deploy pairs the dropped export with an
    // explicit delete-class (clears 10064).
    {
      "tag": "v4",
      "deleted_classes": ["TimerRoomDO"]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": ["NotificationRoom"]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": ["DescriptionRoom"]
    }
  ],
  "routes": [
    {
      "pattern": "tracking.gritoweb.com.br",
      "custom_domain": true
    }
  ]
}
